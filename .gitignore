# at Render build time; never commit the blobs themselves.
data/timetable.json
data/timetable.sqlite
data/timetable.sqlite-wal
data/timetable.sqlite-shm
data/timetable.sqlite.tmp-*
data/timetable.sqlite.sha256.local
data/.nb_quota.json

# Wrangler's local account/build cache — machine-specific, never committed.
.wrangler/

# Screenshot output from scripts/browser_check.mjs --shots
shots/

# Private Euro Bus Expo briefing pack (pitches, Q&A, exhibitor notes, deck).
# Kept local on purpose: never committed to the public repo.
expo-2026/
